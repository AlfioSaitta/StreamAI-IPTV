<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
        Tema principale post-splash. Modalità landscape immersiva (2026-05-15):
        - windowFullscreen: rimuove status bar a livello tema (backup di
          WindowInsetsController in MainActivity).
        - windowLayoutInDisplayCutoutMode=shortEdges: contenuto sotto al notch
          sui lati corti (in landscape, sinistra/destra), evita le "bande
          nere" laterali su device con camera/punch-hole.
        - statusBar/navigationBar trasparenti: l'app disegna edge-to-edge,
          WindowInsetsController nasconde le system bars con swipe-to-reveal
          transient.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Anche il launch theme deve essere fullscreen + cutout shortEdges
             altrimenti durante lo splash si vede status/nav bar e il
             passaggio al tema main appare come un "salto". -->
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>