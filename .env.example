# Sentry configuration for source map uploads
# Copy these variables to a .env or .env.sentry file and fill in the values.
# The .env.sentry file is already in .gitignore.

# Your Sentry organization slug
SENTRY_ORG=

# Your Sentry project slug
SENTRY_PROJECT=

# Your Sentry auth token with project:releases scope
# You can create one here: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
