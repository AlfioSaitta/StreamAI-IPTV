# StreamAI IPTV - variabili d'ambiente locali
# Copia questo file in .env e compila solo le chiavi che vuoi usare.

# Google Gemini AI recommendations
VITE_GEMINI_API_KEY=

# The Movie Database metadata enrichment
VITE_TMDB_API_KEY=

# Opzionale: abilita controlli meno restrittivi in Electron per provider IPTV problematici.
# Valori: 1/true/yes per abilitare; lascia vuoto in produzione se possibile.
STREAMAI_INSECURE_ELECTRON=

# Opzionale: abilita debug WebView Android durante lo sviluppo.
STREAMAI_ANDROID_DEBUG=false

