{
  "name": "streamai-iptv",
  "version": "1.0.1",
  "description": "StreamAI IPTV Player Client",
  "scripts": {
    "start": "npm run wails:run",
    "dev": "npm run wails:dev",
    "build": "vite build --env-file .env.sentry",
    "version:sync": "node scripts/sync-version.mjs",
    "version:print": "node scripts/sync-version.mjs --print",
    "version:full": "node scripts/sync-version.mjs --print-full",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check:media3": "node scripts/check-media3-migration.mjs",
    "check:wails": "node scripts/check-wails-v3.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:go": "CGO_CFLAGS_ALLOW='-fno-strict-overflow|-fstack-clash-protection|-fcf-protection|-fno-omit-frame-pointer' go vet -tags 'gtk3 mpv' ./... && CGO_CFLAGS_ALLOW='-fno-strict-overflow|-fstack-clash-protection|-fcf-protection|-fno-omit-frame-pointer' go build -tags 'gtk3 mpv' -o /dev/null ./cmd/streamai",
    "check": "npm run check:deps && npm run typecheck && npm run test:run && npm run check:media3 && npm run check:wails && npm run check:go && npm run build",
    "wails:build": "bash scripts/build-wails.sh",
    "wails:build:debug": "bash scripts/build-wails.sh --debug",
    "wails:dev": "CGO_CFLAGS_ALLOW='-fno-strict-overflow|-fstack-clash-protection|-fcf-protection|-fno-omit-frame-pointer' wails3 dev",
    "wails:run": "bash scripts/build-wails.sh && ./build/bin/streamai",
    "wails:bindings": "wails3 generate bindings -ts -d frontend/bindings ./...",
    "icons:generate": "node scripts/generate-icons.mjs",
    "gpg:setup": "bash scripts/setup-gpg-key.sh",
    "gpg:upload": "bash scripts/upload-gpg-secrets.sh",
    "dist:linux": "bash scripts/build-linux-wails.sh",
    "dist:linux:opensuse": "bash scripts/build-linux.sh --opensuse",
    "dist:linux:fedora": "bash scripts/build-linux.sh --fedora",
    "dist:linux:rhel": "bash scripts/build-linux.sh --rhel",
    "dist:linux:debian": "bash scripts/build-linux.sh --debian",
    "dist:linux:ubuntu": "bash scripts/build-linux.sh --ubuntu",
    "dist:linux:arch": "bash scripts/build-linux.sh --arch",
    "repo:publish": "bash scripts/publish-repo.sh",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "vite build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:build:release": "bash scripts/android-build-release.sh",
    "android:run": "vite build && npx cap sync android && npx cap run android"
  },
  "author": "StreamAI",
  "license": "MIT",
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/node": "^20.11.24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "capacitor-video-player": "file:android/plugins/capacitor-video-player",
    "jsdom": "25.0.1",
    "lucide-react": "^0.344.0",
    "postcss": "^8.4.35",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-window": "^2.2.3",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "3.2.4",
    "@sentry/vite-plugin": "^5.3.0"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "@wailsio/runtime": "^3.0.0-alpha.79",
    "@sentry/react": "^10.53.1"
  }
}
