{
  "name": "streamai-iptv",
  "version": "1.0.0",
  "description": "StreamAI IPTV Player Client",
  "main": "main.js",
  "scripts": {
    "start": "vite build && electron .",
    "start:quiet": "vite build && electron . 2>/dev/null",
    "dev": "electron .",
    "dev:quiet": "electron . 2>/dev/null",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "check:media3": "node scripts/check-media3-migration.mjs",
    "check": "npm run typecheck && npm run test:run && npm run check:media3 && npm run build",
    "dist:linux": "vite build && electron-builder --linux",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "vite build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "android:build:release": "bash scripts/android-build-release.sh",
    "android:run": "vite build && npx cap sync android && npx cap run android",
    "postinstall": "node scripts/patch-ffmpeg.js || true"
  },
  "author": "StreamAI",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/react": "16.1.0",
    "@types/node": "^20.11.24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/video.js": "^7.3.58",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^37.2.4",
    "electron-builder": "^24.13.0",
    "jsdom": "25.0.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@google/genai": "^1.34.0",
    "@types/react-window": "^1.8.8",
    "@videojs/http-streaming": "^3.17.2",
    "bonjour": "^3.5.0",
    "capacitor-video-player": "file:android/plugins/capacitor-video-player",
    "castv2-client": "^1.2.0",
    "hls.js": "^1.5.7",
    "jmuxer": "^2.0.5",
    "lucide-react": "^0.344.0",
    "mpegts.js": "^1.7.3",
    "node-ssdp": "^4.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-window": "^2.2.3",
    "video.js": "^8.23.4",
    "ws": "^8.20.0"
  },
  "build": {
    "appId": "com.streamai.iptv",
    "productName": "StreamAI",
    "asar": true,
    "compression": "maximum",
    "electronDist": "node_modules/electron/dist",
    "buildDependenciesFromSource": false,
    "files": [
      "dist/**/*",
      "main.js",
      "services/advertisingService.js",
      "icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Video",
      "maintainer": "StreamAI",
      "synopsis": "AI-powered IPTV Player"
    }
  }
}
