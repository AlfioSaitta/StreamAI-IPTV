{
  "name": "streamai-iptv",
  "version": "1.0.0",
  "description": "StreamAI IPTV Player Client",
  "main": "main.js",
  "scripts": {
    "start": "vite build && electron .",
    "build": "vite build",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "author": "StreamAI",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4"
  },
  "dependencies": {
    "@google/genai": "*",
    "hls.js": "^1.5.7",
    "mpegts.js": "^1.7.3",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.streamai.iptv",
    "productName": "StreamAI",
    "asar": true,
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "main.js",
      "icon.png",
      "package.json"
    ],
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Video",
      "maintainer": "StreamAI",
      "synopsis": "AI-powered IPTV Player"
    }
  }
}